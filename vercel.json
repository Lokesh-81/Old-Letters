{
  "version": 2,
  "crons": [
    {
      "path": "/api/scheduler/tick",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|logo\\.png|favicon\\.png|sitemap\\.xml|robots\\.txt|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
