{
  "version": 2,
  "crons": [
    {
      "path": "/api/scheduler/tick",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|sitemap\\.xml|robots\\.txt|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
