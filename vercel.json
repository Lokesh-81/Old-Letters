{
  "version": 2,
  "crons": [
    {
      "path": "/api/scheduler/tick",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|\\.well-known(?:/|$)|manifest\\.webmanifest|logo\\.png|favicon\\.png|sitemap\\.xml|robots\\.txt|google.*\\.html|.*\\.(?:css|js|png|jpg|jpeg|svg|ico|otf|ttf|woff|woff2|webp|avif|json|xml|txt|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
