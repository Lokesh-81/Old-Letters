# ====================================================================
# OLD-LETTERS ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development.
# In production on Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit real credentials or secrets to git.
# ====================================================================

# --------------------------------------------------------------------
# 1. DATABASE (Required for production persistence)
# --------------------------------------------------------------------
# MongoDB Atlas connection string (Cluster -> Connect -> Drivers)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# Database name
MONGODB_DB_NAME="oldletters"

# --------------------------------------------------------------------
# 2. SESSION & SECURITY (Required)
# --------------------------------------------------------------------
# Cryptographic secret used to sign JWT authentication cookies (oldletters_session)
# Generate with: openssl rand -hex 32
JWT_SECRET=""
SESSION_SECRET=""

# Port for local development (defaults to 3000)
PORT=3000

# --------------------------------------------------------------------
# 3. APPLICATION DOMAIN & PUBLIC URL (Required in production)
# --------------------------------------------------------------------
# Local: http://localhost:3000
# Vercel Production: https://your-project.vercel.app
APP_URL="http://localhost:3000"

# --------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Required for "Continue with Google")
# --------------------------------------------------------------------
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
#
# Authorized JavaScript Origins:
#   Local: http://localhost:3000
#   Production: https://your-project.vercel.app
#
# Authorized Redirect URIs:
#   Local: http://localhost:3000/api/auth/google/callback
#   Production: https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# --------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Gmail SMTP via Nodemailer)
# --------------------------------------------------------------------
# Gmail SMTP Host (defaults to smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"

# Gmail SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT="465"

# Secure connection flag (true for 465, false for 587)
SMTP_SECURE="true"

# Dedicated Gmail account address for OLD-LETTERS
SMTP_USER="oldletters.mailroom@gmail.com"

# Google App Password generated under Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=""

ADMIN_EMAIL="admin@old-letters.in"

# --------------------------------------------------------------------
# 6. ADMINISTRATION & CRON SCHEDULER (Optional)
# --------------------------------------------------------------------
# Secret for automated delivery dispatcher (Vercel Cron or external runner)
CRON_SECRET=""
ADMIN_SECRET=""

# --------------------------------------------------------------------
# 7. MANUAL UPI PAYMENT WORKFLOW (Optional)
# --------------------------------------------------------------------
UPI_ID="oldletters@okhdfcbank"
UPI_DISPLAY_NAME="OLD-LETTERS CORRESPONDENCE"
PAYMENT_QR_URL="/assets/upi-qr.png"
