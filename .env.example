# ====================================================================
# OLD-LETTERS ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and provide your production credentials
# ====================================================================

# Port for Full-Stack Server
PORT=3000

# App URL (Frontend Base URL)
APP_URL="http://localhost:3000"

# --- SUPABASE CONFIGURATION ---
# Public Supabase Project URL (Client & Server)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Public Supabase Anon Key (Safe for frontend)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Private Supabase Service Role Key (NEVER expose to browser)
# Used by backend server and Edge Functions for privileged operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- RESEND EMAIL CONFIGURATION ---
# Resend API Key for sending recipient delivery emails and OTP codes
RESEND_API_KEY="re_123456789"

# Verified sender email address configured in Resend (e.g. post@yourdomain.com)
RESEND_FROM_EMAIL="post@old-letters.in"

# --- ADMIN ACCESS ---
# Email address with administrative authorization for payment approvals
ADMIN_EMAIL="admin@old-letters.in"

# --- MANUAL UPI PAYMENT CONFIGURATION ---
# Indian Unified Payments Interface (UPI) ID for digital experience payments
UPI_ID="oldletters@okhdfcbank"

# Official Merchant/Beneficiary Display Name shown in UPI Apps
UPI_DISPLAY_NAME="OLD-LETTERS CORRESPONDENCE"

# Public URL or static path to UPI QR code graphic
PAYMENT_QR_URL="/assets/upi-qr.png"

# Gemini AI (Platform default)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
